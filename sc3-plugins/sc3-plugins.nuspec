<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>sc3plugins</id>
    <version>3.14.0</version>
    <packageSourceUrl>https://github.com/supercollider/sc-chocolatey</packageSourceUrl>
    <title>SuperCollider sc3-plugins</title>
    <authors>SuperCollider Authors</authors>
    <owners>Mike Hodnick</owners>
    <projectUrl>https://github.com/supercollider/sc3-plugins</projectUrl>
    <iconUrl>https://cdn.statically.io/gh/supercollider/supercollider.github.io/f443aa3dc03df0d17c0742af646752b215cd8ff7/images/favicon.png</iconUrl>
    <licenseUrl>https://github.com/supercollider/sc3-plugins/blob/Version-3.14.0/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/supercollider/sc3-plugins</projectSourceUrl>
    <docsUrl>https://docs.supercollider.online/</docsUrl>
    <bugTrackerUrl>https://github.com/supercollider/sc3-plugins/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/supercollider/sc3-plugins/releases/tag/Version-3.14.0</releaseNotes>
    <tags>supercollider sc3-plugins audio</tags>
    <summary>SuperCollider sc3-plugins 3.14.0 install for Windows.</summary>
    <description>Installs the official 64-bit sc3-plugins 3.14.0 release into the current user's SuperCollider Extensions directory and verifies the release archive with its pinned SHA-256 checksum.</description>
    <dependencies>
      <dependency id="supercollider" version="[3.14.1]" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
